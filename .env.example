# ERNS environment configuration
#
# Keys only. Never commit values. Per PB-ENG-12 section 10, .env.example is the single
# documented exception to the rule against committing generated artefacts, and it must be
# committed so the contract is versioned. Values live in a secret store or an untracked .env.
#
# Nothing below is populated. No institutional permission has been granted.

# --- Database (TC-04 PostgreSQL) ---
# Schema owner and app role must differ so REVOKE grants (C-03) are enforceable.
#
# TWO URLs, FOR TWO ROLES. The distinction is enforced by NFR-SEC-015 and
# SECURITY-ARCHITECTURE.md section 9.2, and it is what makes the audit-log permission test
# meaningful: a check run over the owner's connection would prove nothing, because the owner can
# always UPDATE a table it owns.
#
#   ERNS_DATABASE_URL  erns_owner. Applies migrations, creates roles, truncates between tests.
#   ERNS_APP_URL       erns_app. Every runtime query and every privilege assertion.
#
# Roles are provisioned by docker/postgres-init/01-roles.sql. For `docker compose up -d` on a fresh
# clone the values are:
#
#   ERNS_DATABASE_URL=postgresql://postgres:localdev_only@127.0.0.1:5432/erns
#   ERNS_APP_URL=postgresql://erns_app:localdev_app_only@127.0.0.1:5432/erns
#
# Those are local container credentials bound to 127.0.0.1. They are not secrets for any shared
# environment, and PB-ENG-12 forbids placing real credentials in this file.
#
# NOT SET here on purpose: the test suites detect their absence, SKIP with a printed reason, and are
# then reported as NOT RUN. Copy this file to .env.test and fill the two values to enable them.
ERNS_DATABASE_URL=
ERNS_APP_URL=
DATABASE_SCHEMA=erns
DATABASE_MIGRATION_LOCK_TIMEOUT_MS=0

# Migration behaviour
# Migrations are FORWARD ONLY. No down-migration exists and none is claimed; see PB-ENG-14.
DATABASE_MIGRATIONS_FORWARD_ONLY=true

# --- Session (NFR-SEC-003; server-side, revocable) ---
# Generated per environment. A role change MUST invalidate existing sessions (AUTH-13).
SESSION_STORE=
SESSION_IDLE_TIMEOUT_MINUTES_STAFF=30
SESSION_IDLE_TIMEOUT_MINUTES_STUDENT=
SESSION_SECRET=

# --- Correlation (C-07, NFR-MAINT-005) ---
# Propagated across request, audit entries and logs by one identifier.
CORRELATION_HEADER=x-correlation-id
LOG_LEVEL=info

# --- Institutional identity (TC-05 / OQ-45) ---
# NOT CONFIGURED. Institutional single sign-on cannot be implemented until OQ-45 is
# answered and the institution confirms an identity source (OQ-33). No credential is
# requested here because none exists. See docs/architecture/PROJECT-OWNER-DECISIONS.md section 6.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
ALLOWED_EMAIL_DOMAINS=

# --- Email (TC-11 / OQ-32 / OQ-50 / OQ-61 / OQ-62) ---
# NOT CONFIGURED. No sender mailbox exists and no delegated sending has been authorised.
# The console transport is used in development; it sends nothing.
MAIL_TRANSPORT=console
MAIL_FROM_ADDRESS=
MAIL_MAX_ATTEMPTS=

# --- Hosting (TC-09 / OQ-30 / OQ-55) ---
# NOT CONFIGURED. No hosting arrangement exists and none is assumed.
DEPLOYMENT_PLATFORM=
STAGING_URL=